# Copy to .env.local / inject via window.__GADGETBOSS_ENV__ for browser apps.
# NEVER put the service_role key in frontend code.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Optional aliases used by Vite-style tooling
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side / CI only (migrations, admin seed) — do not ship to browsers
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Paystack — public key is safe in the browser; secret key is server/Vercel only
PAYSTACK_PUBLIC_KEY=pk_live_or_pk_test_here
PAYSTACK_SECRET_KEY=sk_live_or_sk_test_here
