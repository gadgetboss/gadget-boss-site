# Copy to .env.local / inject via window.__GADGETBOSS_ENV__ for browser apps.
# NEVER put the service_role key in frontend code.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Optional aliases used by Vite-style tooling
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side / CI only (migrations, admin seed, /api/account/* order lookups)
# — do not ship to browsers
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Paystack — public key is safe in the browser; secret key is server/Vercel only
PAYSTACK_PUBLIC_KEY=pk_live_or_pk_test_here
PAYSTACK_SECRET_KEY=sk_live_or_sk_test_here

# Hubtel OTP passwordless sign-in — ALL server-side only (api/auth/*, server.py).
# Never inject these into index.html / window.__GADGETBOSS_ENV__ or any browser code.
# Until HUBTEL_CLIENT_ID, HUBTEL_CLIENT_SECRET and SESSION_SECRET are all set,
# /api/auth/request-otp answers 200 { configured: false } and checkout behaves
# exactly as it does today.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=GADGETBOSS
HUBTEL_OTP_BASE_URL=https://api-otp.hubtel.com
# Long random string (e.g. `openssl rand -hex 32`). Signs the gb_otp / gb_session
# cookies; rotating it signs every customer out.
SESSION_SECRET=
